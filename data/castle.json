                "style": "secondary",
                "targetId": "act_princess_stay",
                "defaultOptionIndex": 0
              }
            ]
          },
          {
            "id": "act_princess_leave",
            "type": "action",
            "title": "🎬 公主离队",
            "x": 890,
            "y": 60,
            "steps": [
              {
                "type": "set",
                "var": "party.princess",
                "value": false
              },
              {
                "type": "say",
                "speaker": "紫水晶公主",
                "speakerTitle": "王城公主 (离队)",
                "avatar": "👸",
                "text": "对不起勇者大人，我会在这里为你祈祷的。\n我不在的话还请记得适量[color=#00e676]提升防御[/color]来避免不必要的伤害啊~",
                "button": "保重"
              }
            ]
          },
          {
            "id": "act_princess_stay",
            "type": "action",
            "title": "🎬 继续同行",
            "x": 890,
            "y": 221,
            "steps": [
              {
                "type": "say",
                "speaker": "国王",
                "speakerTitle": "王城统治者",
                "avatar": "👑",
                "text": "那就好，愿神佑你们一切顺利！",
                "button": "谢陛下"
              }
            ]
          },
