      "x": 60,
      "y": 100,
      "incomingTriggers": [
        "trig_has_book",
        "trig_princess_in_party"
      ],
      "actionGraph": {
        "nodes": [
          {
            "id": "start_king",
            "type": "start",
            "x": 40,
            "y": 318,
            "nextId": "sel_king",
            "defaultOptionIndex": 0
          },
