            "x": 560,
            "y": 448,
            "steps": [
              {
                "type": "say",
                "speaker": "国王",
                "speakerTitle": "王城统治者",
                "avatar": "👑",
                "text": "请带上这本[color=#cc0000]冒险书[/color]和[color=#cc0000]地图[/color]吧，激活地图上标注的[color=#cc0000]女神像[/color]就可以传送了。请去城堡里的女神像试一试！",
                "button": "收下宝物"
              },
              {
                "type": "set",
                "var": "items.book",
                "value": true
              },
              {
                "type": "set",
                "var": "items.map",
                "value": true
              }
            ]
          }
        ]
      }
