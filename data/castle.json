    {
      "id": "evt_maid_white",
      "title": "🛡️ 女仆·小白 (防御)",
      "sourceRef": "maid_white (add_defence)",
      "desc": "消耗金币强化防御力：每 10G 提升 1 点。",
      "x": 340,
      "y": 560,
      "branches": [
        {
          "id": "b_maid_white_train",
          "title": "训练防御",
          "when": [],
          "steps": [
