                    "value": true
                  },
                  {
                    "triggerId": "trig_princess_in_party",
                    "op": "==",
                    "value": true
                  }
                ],
                "targetId": "choice_king_princess",
                "defaultOptionIndex": 0
              },
              {
                "id": "case_guide",
                "title": "持有冒险书",
                "checks": [
                  {
                    "triggerId": "trig_has_book",
                    "op": "==",
                    "value": true
                  }
                ],
                "targetId": "act_king_guide",
                "defaultOptionIndex": 0
              }
            ],
            "defaultTargetId": "act_king_first",
            "defaultOptionIndex": 0
          },
