  "triggers": [
    {
      "id": "trig_has_book",
      "title": "⚡ trigger: 持有冒险书",
      "desc": "改变国王（日常指引 / 劝离公主）与离开城堡大门（门禁 1）的行为。",
      "x": 460,
      "y": 100,
      "match": "all",
      "conds": [
        {
          "var": "items.book",
          "op": "==",
          "value": true
        }
      ]
    },
    {
      "id": "trig_castle_tp",
      "title": "⚡ trigger: 传送点已激活",
      "desc": "改变离开城堡大门（门禁 2）的行为。",
      "x": 452,
      "y": 269,
      "match": "all",
      "conds": [
        {
          "var": "teleports.castle",
          "op": "==",
          "value": true
        }
      ]
    },
    {
      "id": "trig_princess_in_party",
      "title": "⚡ trigger: 公主在队伍",
      "desc": "改变公主的床（就寝回满HP）、大钟柜（领取私房钱）与国王（劝离公主）的行为。",
      "x": 460,
      "y": 380,
      "match": "all",
      "conds": [
        {
          "var": "party.princess",
          "op": "==",
          "value": true
        }
      ]
    },
    {
      "id": "trig_castle_exited",
      "title": "⚡ trigger: 已离开城堡",
      "desc": "改变下个区域（郊外与海滩）的行为：未出城时为远眺，出城后开放。",
      "x": 1220,
      "y": 170,
      "match": "all",
      "conds": [
        {
          "var": "regions.castle_exited",
          "op": "==",
          "value": true
        }
      ]
    },
    {
      "id": "trig_has_hp_gem",
      "title": "⚡ trigger: 持有生命宝珠",
      "desc": "改变女仆·小绿的行为：生命强化效果翻倍。",
      "x": 640,
      "y": 690,
      "match": "all",
      "conds": [
        {
          "var": "items.hp_gem",
          "op": "==",
          "value": true
        }
      ]
    }
  ],
  "events": [
    {
      "id": "evt_king",
      "title": "👑 国王 (king_conversation)",
      "sourceRef": "king_conversation",
      "desc": "王城最高统治者。初见赐予冒险书与地图；之后给出日常指引；公主在队时可劝说公主离队。",
      "x": 60,
      "y": 100,
      "branches": [
        {
          "id": "b_king_persuade",
          "title": "劝说公主离队",
          "when": [
            "trig_has_book",
            "trig_princess_in_party"
          ],
          "steps": [
            {
              "type": "choice",
              "speaker": "国王",
              "speakerTitle": "王城统治者",
              "avatar": "👑",
              "text": "公主有没有给你添麻烦？需要我来劝说她离队么？",
              "options": [
                {
                  "text": "好的 (劝说离队)",
                  "style": "danger",
                  "steps": [
                    {
                      "type": "set",
                      "var": "party.princess",
                      "value": false
                    },
                    {
                      "type": "say",
                      "speaker": "紫水晶公主",
                      "speakerTitle": "王城公主 (离队)",
                      "avatar": "👸",
                      "text": "对不起勇者大人，我会在这里为你祈祷的。\n我不在的话还请记得适量[color=#00e676]提升防御[/color]来避免不必要的伤害啊~",
                      "button": "保重"
                    }
                  ]
                },
                {
                  "text": "算了 (继续同行)",
                  "style": "secondary",
                  "steps": [
                    {
                      "type": "say",
                      "speaker": "国王",
                      "speakerTitle": "王城统治者",
                      "avatar": "👑",
                      "text": "那就好，愿神佑你们一切顺利！",
                      "button": "谢陛下"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "b_king_guide",
          "title": "日常指引",
          "when": [
            "trig_has_book"
          ],
          "steps": [
            {
              "type": "say",
              "speaker": "国王",
              "speakerTitle": "王城统治者",
              "avatar": "👑",
              "text": "海滩对面的[color=#cc0000]精灵村[/color]，可以快速训练能力。还请在清理完城堡周边后优先拜访！",
              "button": "谨遵陛下嘱托"
            }
          ]
        },
        {
          "id": "b_king_first",
          "title": "初见赐物",
          "when": [],
          "steps": [
            {
              "type": "say",
              "speaker": "国王",
              "speakerTitle": "王城统治者",
              "avatar": "👑",
              "text": "请带上这本[color=#cc0000]冒险书[/color]和[color=#cc0000]地图[/color]吧，激活地图上标注的[color=#cc0000]女神像[/color]就可以传送了。请去城堡里的女神像试一试！",
              "button": "收下宝物"
            },
            {
              "type": "set",
              "var": "items.book",
              "value": true
            },
            {
              "type": "set",
              "var": "items.map",
              "value": true
            }
          ]
        }
      ],
      "incomingTriggers": [
        "trig_has_book",
        "trig_princess_in_party"
      ]
    },
    {
      "id": "evt_statue_castle",
      "title": "🗽 城堡女神像",
      "sourceRef": "castle_statue / enable_teleport",
      "desc": "王城内的远古女神雕像。初次祈祷激活王城传送点。",
      "x": 60,
      "y": 240,
      "incomingTriggers": [],
      "branches": [
        {
          "id": "b_statue_activate",
          "title": "激活传送点",
          "when": [],
          "steps": [
            {
              "type": "say",
              "speaker": "女神像",
              "speakerTitle": "远古神迹",
              "avatar": "🗽",
              "text": "[color=#00e676]城堡[/color] 传送点已激活！可以在地图上传送了。\n\n[color=#ff9100]小提示[/color]：\n1. 可以随时在设置中保存/读取游戏哦\n2. 拖拽屏幕可以查看地图哦",
              "button": "虔诚祈祷"
            },
            {
              "type": "set",
              "var": "teleports.castle",
              "value": true
            }
          ]
        }
      ]
    },
    {
      "id": "evt_exit_castle",
      "title": "🚪 离开城堡大门",
      "sourceRef": "hero_leave_castle_block",
      "desc": "城堡出口门禁。需同时持有冒险书并激活传送点，否则公主会在门前提醒。",
      "x": 820,
      "y": 170,
      "branches": [
        {
          "id": "b_exit_pass",
          "title": "出城通行",
          "when": [
            "trig_has_book",
            "trig_castle_tp"
          ],
          "steps": [
            {
              "type": "say",
              "speaker": "系统播报",
              "speakerTitle": "区域突破",
              "avatar": "🎉",
              "text": "[color=#00e676]大门轰然开启！[/color]\n你佩戴着冒险书与地图，脚踏传送光阵走出城堡。\n\n已解锁【🏖️ 下一区域：郊外与海滩】！",
              "button": "奔向郊外与海滩"
            },
            {
              "type": "set",
              "var": "regions.castle_exited",
              "value": true
            }
          ]
        },
        {
          "id": "b_exit_need_tp",
          "title": "提醒激活女神像",
          "when": [
            "trig_has_book"
          ],
          "steps": [
            {
              "type": "say",
              "speaker": "紫水晶公主",
              "speakerTitle": "王城公主 (拦截指引)",
              "avatar": "👸",
              "text": "勇者大人，去激活一下[color=#ff9100]城堡里的女神像[/color]吧，这样就可以[color=#00e676]随时传送回来[/color]了~",
              "button": "去激活女神像"
            }
          ]
        },
        {
          "id": "b_exit_need_book",
          "title": "提醒觐见国王",
          "when": [],
          "steps": [
            {
              "type": "say",
              "speaker": "紫水晶公主",
              "speakerTitle": "王城公主 (拦截指引)",
              "avatar": "👸",
              "text": "勇者大人，[color=#ff5252]陛下还在等着您[/color]呢~ 还没有带上冒险书可不能冒然出城哦！",
              "button": "折回王座"
            }
          ]
        }
      ],
      "incomingTriggers": [
        "trig_has_book",
        "trig_castle_tp"
      ]
    },
    {
      "id": "evt_princess_join",
      "title": "👸 紫水晶公主 (对话)",
      "sourceRef": "princess_conversation",
      "desc": "城内闲逛的紫水晶公主。可邀请入队（熔断噩梦成就）。",
      "x": 60,
      "y": 380,
      "branches": [
        {
          "id": "b_princess_invite",
          "title": "邀请入队",
          "when": [],
          "steps": [
            {
              "type": "choice",
              "speaker": "紫水晶公主",
              "speakerTitle": "王城公主",
              "avatar": "👸",
              "text": "可以带我一起去旅行么？\n([color=#ff5252]注：公主可以战斗后回血，全程不带公主是噩梦难度，第一次游戏推荐带公主[/color])",
              "options": [
                {
                  "text": "好的 (邀请入队)",
                  "style": "primary",
                  "steps": [
                    {
                      "type": "set",
                      "var": "party.princess",
                      "value": true
                    },
                    {
                      "type": "set",
                      "var": "achievements.no_use_princess",
                      "value": "failed"
                    },
                    {
                      "type": "say",
                      "speaker": "紫水晶公主",
                      "speakerTitle": "队伍同伴",
                      "avatar": "👸",
                      "text": "谢谢，我会努力协助勇者大人的！(此后您可以使用我的床休息，也可以领取私房钱了哦~)",
                      "button": "出发！"
                    }
                  ]
                },
                {
                  "text": "算了 (独自踏上旅程)",
                  "style": "secondary",
                  "steps": [
                    {
                      "type": "say",
                      "speaker": "紫水晶公主",
                      "speakerTitle": "王城公主",
                      "avatar": "👸",
                      "text": "好吧，如果改变了主意随时回来找我啊！我会一直在这里等您回心转意的。",
                      "button": "好的"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ],
      "incomingTriggers": []
    },
    {
      "id": "evt_princess_bed",
      "title": "🛏️ 公主的床",
      "sourceRef": "princess_bed",
      "desc": "公主寝宫里的床铺。默认只是观察；公主在队时可就寝回满 HP。",
      "x": 820,
      "y": 320,
      "branches": [
        {
          "id": "b_bed_rest",
          "title": "就寝休息",
          "when": [
            "trig_princess_in_party"
          ],
          "steps": [
            {
              "type": "choice",
              "speaker": "紫水晶公主",
              "speakerTitle": "队伍同伴",
              "avatar": "👸",
              "text": "勇者大人，需要的话请在床上休息一会儿吧！\n([color=#ff9100]注：床可以无限使用回满HP，但通关时会获得普通难度评价[/color])",
              "options": [
                {
                  "text": "好的 (就寝休息)",
                  "style": "primary",
                  "steps": [
                    {
                      "type": "set",
                      "var": "hero.hp",
                      "from": "hero.maxHp"
                    },
                    {
                      "type": "set",
                      "var": "achievements.no_use_bed",
                      "value": "failed"
                    },
                    {
                      "type": "say",
                      "speaker": "系统提示",
                      "speakerTitle": "体力恢复",
                      "avatar": "💖",
                      "text": "精神焕发！勇者的生命值已完全恢复为 [color=#00e676]{hero.hp}/{hero.maxHp}[/color]！",
                      "button": "神清气爽"
                    }
                  ]
                },
                {
                  "text": "算了 (稍后再休息)",
                  "style": "secondary",
                  "steps": []
                }
              ]
            }
          ]
        },
        {
          "id": "b_bed_look",
          "title": "默认观察",
          "when": [],
          "steps": [
            {
              "type": "say",
              "speaker": "环境观察",
              "speakerTitle": "城堡寝宫",
              "avatar": "🛏️",
              "text": "一张看起来非常整洁的床。床单铺得一丝不苟，似乎属于公主殿下。",
              "button": "离开"
            }
          ]
        }
      ],
      "incomingTriggers": [
        "trig_princess_in_party"
      ]
    },
    {
      "id": "evt_clock_cabinet",
      "title": "🕰️ 大钟柜",
      "sourceRef": "clock_cabinet",
      "desc": "走廊的长廊钟柜。默认只是观察；公主在队时可领取私房钱。",
      "x": 820,
      "y": 440,
      "branches": [
        {
          "id": "b_clock_money",
          "title": "领取私房钱",
          "when": [
            "trig_princess_in_party"
          ],
          "steps": [
            {
              "type": "choice",
              "speaker": "紫水晶公主",
              "speakerTitle": "队伍同伴",
              "avatar": "👸",
              "text": "勇者大人，这里有我的一些私房钱，请拿去使用吧。\n([color=#ff9100]注：私房钱可以无限领取，但通关时会获得简单难度评价[/color])",
              "options": [
                {
                  "text": "收下私房钱 (+100G)",
                  "style": "primary",
                  "steps": [
                    {
                      "type": "add",
                      "var": "hero.gold",
                      "amount": 100
                    },
                    {
                      "type": "set",
                      "var": "achievements.no_use_money",
                      "value": "failed"
                    },
                    {
                      "type": "set",
                      "var": "achievements.no_use_bed",
                      "value": "failed"
                    },
                    {
                      "type": "say",
                      "speaker": "系统提示",
                      "speakerTitle": "资金入账",
                      "avatar": "💰",
                      "text": "收下了沉甸甸的钱包！当前金币变为 [color=#ffd700]{hero.gold} Gold[/color]！",
                      "button": "多谢公主"
                    }
                  ]
                },
                {
                  "text": "算了 (留给公主)",
                  "style": "secondary",
                  "steps": []
                }
              ]
            }
          ]
        },
        {
          "id": "b_clock_look",
          "title": "默认观察",
          "when": [],
          "steps": [
            {
              "type": "say",
              "speaker": "环境观察",
              "speakerTitle": "城堡长廊",
              "avatar": "🕰️",
              "text": "大钟发出着哒，哒的声音。下面还有个精致的小盒子，似乎是属于公主的。",
              "button": "合上盒子"
            }
          ]
        }
      ],
      "incomingTriggers": [
        "trig_princess_in_party"
      ]
    },
    {
      "id": "evt_maid_black",
      "title": "⚔️ 女仆·小黑 (攻击)",
      "sourceRef": "maid_black (add_attack)",
      "desc": "消耗金币强化攻击力：10G → +1；100G → +10。",
      "x": 40,
      "y": 560,
      "branches": [
        {
          "id": "b_maid_black_train",
          "title": "训练攻击",
          "when": [],
          "steps": [
            {
              "type": "choice",
              "speaker": "女仆·小黑",
              "speakerTitle": "武艺侍从",
              "avatar": "⚔️",
              "text": "勇者大人，需要训练一下攻击能力么？\n当前攻击力：[color=#ff5252]{hero.attack}[/color]，当前金币：[color=#ffd700]{hero.gold} G[/color]",
              "options": [
                {
                  "text": "训练 10 次 (-100G, +10攻)",
                  "style": "primary",
                  "require": [
                    {
                      "var": "hero.gold",
                      "op": ">=",
                      "value": 100
                    }
                  ],
                  "steps": [
                    {
                      "type": "add",
                      "var": "hero.gold",
                      "amount": -100
                    },
                    {
                      "type": "add",
                      "var": "hero.attack",
                      "amount": 10
                    }
                  ]
                },
                {
                  "text": "训练 1 次 (-10G, +1攻)",
                  "style": "primary",
                  "require": [
                    {
                      "var": "hero.gold",
                      "op": ">=",
                      "value": 10
                    }
                  ],
                  "steps": [
                    {
                      "type": "add",
                      "var": "hero.gold",
                      "amount": -10
                    },
                    {
                      "type": "add",
                      "var": "hero.attack",
                      "amount": 1
                    }
                  ]
                },
                {
                  "text": "稍后再来",
                  "style": "secondary",
                  "steps": []
                }
              ]
            }
          ]
        }
      ],
      "incomingTriggers": []
