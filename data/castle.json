  "triggers": [
    {
      "id": "trig_has_book",
      "title": "⚡ trigger: 持有冒险书",
      "desc": "改变国王（日常指引 / 劝离公主）与离开城堡大门（门禁 1）的行为。",
      "x": 460,
      "y": 100,
      "match": "all",
      "conds": [
        {
          "var": "items.book",
          "op": "==",
          "value": true
        }
      ]
    },
    {
      "id": "trig_castle_tp",
      "title": "⚡ trigger: 传送点已激活",
      "desc": "改变离开城堡大门（门禁 2）的行为。",
      "x": 441,
      "y": 223,
      "match": "all",
      "conds": [
        {
          "var": "teleports.castle",
          "op": "==",
          "value": true
        }
      ]
    },
    {
      "id": "trig_princess_in_party",
      "title": "⚡ trigger: 公主在队伍",
      "desc": "改变公主的床（就寝回满HP）、大钟柜（领取私房钱）与国王（劝离公主）的行为。",
      "x": 443,
      "y": 352,
      "match": "all",
      "conds": [
        {
          "var": "party.princess",
          "op": "==",
          "value": true
        }
      ]
    },
    {
      "id": "trig_castle_exited",
      "title": "⚡ trigger: 已离开城堡",
      "desc": "改变下个区域（郊外与海滩）的行为：未出城时为远眺，出城后开放。",
      "x": 1220,
      "y": 170,
      "match": "all",
      "conds": [
        {
          "var": "regions.castle_exited",
          "op": "==",
          "value": true
        }
      ]
    },
    {
      "id": "trig_has_hp_gem",
      "title": "⚡ trigger: 持有生命宝珠",
      "desc": "改变女仆·小绿的行为：生命强化效果翻倍。",
      "x": 640,
      "y": 690,
      "match": "all",
      "conds": [
        {
          "var": "items.hp_gem",
          "op": "==",
          "value": true
